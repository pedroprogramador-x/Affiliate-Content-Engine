# Variáveis de ambiente da API do ACE (apps/api).
#
# Este arquivo é um template com PLACEHOLDERS. Nunca faça commit de um
# `.env` com valores reais. A referência raiz do monorepo está em
# `../../.env.example`.
#
# Etapa 1B: a aplicação ainda NÃO lê variáveis de ambiente em código
# (não existe camada de configuração/settings — seria abstração
# prematura para esta etapa). As variáveis abaixo servem apenas para o
# comando local do servidor de desenvolvimento (uvicorn) e para uso
# futuro.

# Host e porta usados ao subir o servidor local de desenvolvimento.
API_HOST=127.0.0.1
API_PORT=8000

# Ambiente lógico e nível de log — reservados para uso futuro; ainda
# não consumidos por código nesta etapa.
ENVIRONMENT=development
LOG_LEVEL=info
