# Copie este arquivo para `.env` (na raiz e/ou em apps/web e apps/api, conforme
# a Etapa em que os apps forem criados) e preencha com valores reais.
# NUNCA faça commit de um arquivo `.env` com segredos reais.

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase (Database / Auth / Storage)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Variáveis expostas ao frontend (Next.js) precisam do prefixo NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Providers de marketplace / IA
# ---------------------------------------------------------------------------
# Cada provider desacoplado (marketplace, IA, etc.) terá suas próprias
# variáveis de credencial adicionadas incrementalmente quando for
# implementado. Nenhum provider é obrigatório para o sistema funcionar
# (API-first + fallback manual — ver docs/adr).
